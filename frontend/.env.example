# Provider werden in dieser Reihenfolge versucht. Secrets nie in den Browser geben.
AI_PROVIDER_ORDER=ollama,cloudflare,groq,openrouter,huggingface,openai

# Explizite Gates: standardmäßig deaktiviert. Erst nach Sandbox-/Workspace-Review aktivieren.
ENABLE_WORKSPACE_WRITES=false
ENABLE_CODE_EXECUTION=false
WORKSPACE_ROOT=.

# API-key-freier Betrieb mit dem OSS-Container (z.B. auf einem eigenen Server)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3-coder:30b

# Optionale Cloud-Fallbacks. Diese Anbieter sind kostenlos begrenzt, aber nicht credential-frei.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/qwen/qwen3-30b-a3b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
HF_TOKEN=
HF_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct

# Optionaler klassischer OpenAI-kompatibler Provider
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
